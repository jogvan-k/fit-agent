{
  "name": "@jogvan-k/fit-agent",
  "version": "0.1.4",
  "description": "Safe typed FitAgent CLI tools for OpenClaw fitness workspaces and workout calendars",
  "type": "module",
  "license": "MIT",
  "author": "jogvan-k",
  "repository": {
    "type": "git",
    "url": "https://github.com/jogvan-k/fit-agent.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/jogvan-k/fit-agent/tree/main/plugin",
  "keywords": [
    "openclaw",
    "fit-agent",
    "intervals-icu",
    "fitness",
    "workout",
    "calendar"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "schemas",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "validate": "npm run build && node scripts/validate.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "openclaw": "2026.10.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.0",
    "eslint": "9.39.4",
    "openclaw": "2026.10.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "clawhub": "0.23.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    }
  }
}
