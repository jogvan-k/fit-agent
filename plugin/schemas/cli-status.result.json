{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "latestActivityDate": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latestWellnessMonth": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dataModifiedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "plannedWorkoutCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "upcomingDates": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "athleteProfileExists": {
              "type": "boolean"
            },
            "trainingPlanExists": {
              "type": "boolean"
            }
          },
          "required": [
            "workspace",
            "latestActivityDate",
            "latestWellnessMonth",
            "dataModifiedAt",
            "plannedWorkoutCount",
            "upcomingDates",
            "athleteProfileExists",
            "trainingPlanExists"
          ],
          "additionalProperties": false
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "ok",
        "data",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "enum": [
                "binary",
                "workspace",
                "profile/config",
                "Intervals authentication",
                "network",
                "validation",
                "sync conflict"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "layer",
            "message"
          ],
          "additionalProperties": false
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "ok",
        "error",
        "schemaVersion"
      ],
      "additionalProperties": false
    }
  ]
}
